{
  "name": "glovear",
  "version": "1.1.0",
  "private": true,
  "description": "VONGOLA glove AR demo and measurement frontend",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.jayjie.glovear",
    "productName": "GloveAR",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "vendor/**/*",
      "glove.glb",
      "electron/main.js",
      "electron/static-server.js",
      "electron/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "GloveAR-${version}.exe"
    }
  }
}
